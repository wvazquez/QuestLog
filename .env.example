# Copy this file to .env.local and fill in your Supabase project values.
# .env.local is gitignored — never commit actual credentials.
#
# Get these values from: https://supabase.com/dashboard/project/<your-project>/settings/api

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key-here
