{
  "source": {
    "include": ["src"],
    "includePattern": "\\.js$",
    "excludePattern": "(\\.test\\.js$|node_modules)"
  },
  "opts": {
    "destination": "docs/api",
    "recurse": true,
    "readme": "docs/index.md"
  },
  "plugins": [],
  "templates": {
    "cleverLinks": false,
    "monospaceLinks": true,
    "default": {
      "outputSourceFiles": true,
      "includeDate": false
    }
  },
  "tags": {
    "allowUnknownTags": true
  }
}
